    {
      "name": "3. Nhập Điểm Hợp Lệ (Test gRPC Sync + Kafka Async Event)",
      "item": [
        {
          "name": "3.1. Nhập điểm môn 1 (Điểm cao: 8.5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 201 Created (Xác thực gRPC thành công & Bắn Kafka Event)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Điểm số được lưu chính xác\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.studentId).to.eql(Number(pm.collectionVariables.get(\"studentId\")));",
                  "    pm.expect(json.score).to.eql(8.5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}},\n  \"subjectName\": \"Kiến trúc Microservices\",\n  \"credits\": 3,\n  \"score\": 8.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/grades",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grades"]
            }
          }
        },
        {
          "name": "3.2. Nhập điểm môn 2 (Điểm 9.0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}},\n  \"subjectName\": \"Lập trình mạng nâng cao\",\n  \"credits\": 2,\n  \"score\": 9.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/grades",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grades"]
            }
          }
        },
        {
          "name": "3.3. Xem bảng điểm & GPA tích lũy của sinh viên (GET /api/grades/student/{id})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"GPA tính đúng và trạng thái ĐỖ\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.gpa).to.be.greaterThan(5.0);",
                  "    pm.expect(json.status).to.eql(\"ĐỖ\");",
                  "    pm.expect(json.grades.length).to.be.at.least(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/grades/student/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grades", "student", "{{studentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Nhập Điểm Lỗi Với ID Không Tồn Tại (Test gRPC Báo Lỗi 404)",
      "item": [
        {
          "name": "4.1. Nhập điểm với studentId = 99999 (Kỳ vọng: HTTP 404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 404 Not Found từ gRPC validation\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Thông báo lỗi xác thực gRPC rõ ràng\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include(\"Không tìm thấy sinh viên có ID: 99999\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": 99999,\n  \"subjectName\": \"Toán rời rạc\",\n  \"credits\": 3,\n  \"score\": 7.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/grades",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grades"]
            }
          }
        }
      ]
