                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/search?keyword=Nguyen",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "search"],
              "query": [
                {
                  "key": "keyword",
                  "value": "Nguyen"
                }
              ]
            }
          }
        },
        {
          "name": "2.4. Lấy tất cả sinh viên (GET /api/students)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
