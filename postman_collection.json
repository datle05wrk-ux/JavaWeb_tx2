                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Khớp mã sinh viên\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.studentCode).to.eql(pm.collectionVariables.get(\"studentCode\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/code/{{studentCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "code", "{{studentCode}}"]
            }
          }
        },
        {
          "name": "2.3. Tìm kiếm theo Từ Khóa (GET /api/students/search?keyword=...)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Danh sách tìm kiếm là mảng có phần tử\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "    pm.expect(json.length).to.be.greaterThan(0);",
                  "});"
