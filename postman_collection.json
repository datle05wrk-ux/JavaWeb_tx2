{
  "info": {
    "name": "Student Management Microservices - Full Test Suite",
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "description": "Bộ kiểm thử API tự động cho hệ thống Microservices: Student Service, Grade Service, Analytics Service qua API Gateway (Port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "studentCode",
      "value": "SV202601",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Thêm Sinh Viên Mới (POST /api/students)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP Status 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Trả về đúng thông tin sinh viên vừa tạo\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "    pm.expect(json.studentCode).to.eql(pm.collectionVariables.get(\"studentCode\"));",
              "    pm.collectionVariables.set(\"studentId\", json.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentCode\": \"{{studentCode}}\",\n  \"fullName\": \"Nguyễn Văn An\",\n  \"birthYear\": 2004,\n  \"email\": \"an.nguyen@haui.edu.vn\",\n  \"major\": \"Công nghệ thông tin\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        }
      }
    },
    {
      "name": "2. Tìm Kiếm & Tra Cứu Sinh Viên",
      "item": [
        {
          "name": "2.1. Tra cứu theo ID (GET /api/students/{id})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Khớp ID sinh viên\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(Number(pm.collectionVariables.get(\"studentId\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "{{studentId}}"]
            }
          }
        },
        {
          "name": "2.2. Tra cứu theo Mã Sinh Viên (GET /api/students/code/{code})",
          "event": [
            {
              "listen": "test",
