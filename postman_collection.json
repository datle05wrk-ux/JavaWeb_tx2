    {
      "name": "5. Lọc Danh Sách Sinh Viên (Analytics Service)",
      "item": [
        {
          "name": "5.1. Lọc theo Năm sinh, Khoảng điểm & Trạng thái ĐỖ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Tất cả sinh viên trả về đều có trạng thái ĐỖ và năm sinh 2004\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "    json.forEach(function(item) {",
                  "        pm.expect(item.status).to.eql(\"ĐỖ\");",
                  "        pm.expect(item.birthYear).to.eql(2004);",
                  "        pm.expect(item.gpa).to.be.at.least(5.0);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analytics/filter?birthYear=2004&minGpa=5.0&maxGpa=10.0&status=ĐỖ",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "filter"],
              "query": [
                {
                  "key": "birthYear",
                  "value": "2004"
                },
                {
                  "key": "minGpa",
                  "value": "5.0"
                },
                {
                  "key": "maxGpa",
                  "value": "10.0"
                },
                {
                  "key": "status",
                  "value": "ĐỖ"
                }
              ]
            }
          }
        },
